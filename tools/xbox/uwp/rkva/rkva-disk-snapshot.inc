// Included in remote-attn-engine.cpp after Session is complete. No hot-path I/O.
#include "rkva-snapshot-digest.h"
#include <filesystem>
#include <fstream>
#include <iterator>
#include <stdexcept>

namespace rkva_snapshot {
namespace fs = std::filesystem;
constexpr uint64_t chunk_bytes = 8ull << 20;
constexpr uint64_t snapshot_limit = 4ull << 30;
constexpr uint64_t store_limit = 8ull << 30;
constexpr size_t retained_snapshots = 4;
constexpr uint32_t max_chunks = 4096;
#pragma pack(push, 1)
struct Header {
    uint32_t magic = 0x534b5652; // RVKS
    uint32_t version = 1;
    rkva_snapshot_req request{};
    RemoteAttnEngine::Geometry geometry{};
    rkva_kvarn_range_config descriptor{};
    uint32_t origin = 0, capacity = 0, storage = 0, chunks = 0;
    uint64_t payload_bytes = 0;
};
struct Chunk {
    uint32_t layer = 0;
    uint32_t bytes = 0;
    uint64_t offset = 0;
    Digest sha{};
};
#pragma pack(pop)
inline bool opaque_name(const std::string& name) {
    return name.size() == 64 && name.find_first_not_of("0123456789abcdef") == std::string::npos;
}
inline fs::path chunk_path(const fs::path& dir, size_t index) {
    return dir / (std::to_string(index) + ".kv");
}
inline void read_exact(std::ifstream& file, void* dst, size_t bytes) {
    if (!file.read(static_cast<char*>(dst), std::streamsize(bytes)))
        throw std::runtime_error("snapshot: truncated/unreadable file");
}
inline void write_exact(const fs::path& path, const void* data, size_t bytes) {
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file || !file.write(static_cast<const char*>(data), std::streamsize(bytes)))
        throw std::runtime_error("snapshot: disk write failed");
    file.flush();
    if (!file)
        throw std::runtime_error("snapshot: disk flush failed");
    file.close();
    if (!file)
        throw std::runtime_error("snapshot: disk close failed");
}
inline void check_regular(const fs::path& path, uint64_t bytes) {
    if (fs::is_symlink(fs::symlink_status(path)) || !fs::is_regular_file(path) ||
        fs::file_size(path) != bytes)
        throw std::runtime_error("snapshot: invalid file type/extent");
}
inline std::vector<Chunk> read_manifest(const fs::path& dir, const Header& expected) {
    if (fs::is_symlink(fs::symlink_status(dir)) || !fs::is_directory(dir))
        throw std::runtime_error("snapshot: missing directory");
    const fs::path path = dir / "manifest.bin";
    const uint64_t bytes = sizeof(Header) + uint64_t(expected.chunks) * sizeof(Chunk) + 32;
    check_regular(path, bytes);
    std::ifstream file(path, std::ios::binary);
    Header actual{};
    read_exact(file, &actual, sizeof(actual));
    if (std::memcmp(&actual, &expected, sizeof(actual)))
        throw std::runtime_error("snapshot: identity/geometry/descriptor mismatch");
    std::vector<Chunk> chunks(expected.chunks);
    read_exact(file, chunks.data(), chunks.size() * sizeof(Chunk));
    Digest stored{};
    read_exact(file, stored.data(), stored.size());
    Sha256 hash;
    hash.update(&actual, sizeof(actual));
    hash.update(chunks.data(), chunks.size() * sizeof(Chunk));
    if (hash.finish() != stored)
        throw std::runtime_error("snapshot: manifest checksum mismatch");
    return chunks;
}
// Only the dedicated LocalState subdirectory and names generated by us are
// visited. No supplied paths, symlinks, recursive cross-directory traversal.
inline void make_room(const fs::path& root, const fs::path& destination, uint64_t requested) {
    struct Entry {
        fs::path path;
        fs::file_time_type time;
        uint64_t bytes;
    };
    std::vector<Entry> entries;
    uint64_t total = 0;
    size_t scanned = 0;
    for (const auto& entry : fs::directory_iterator(root)) {
        if (++scanned > 64)
            throw std::runtime_error("snapshot: directory entry limit");
        const std::string name = entry.path().filename().string();
        if (fs::is_symlink(entry.symlink_status()))
            continue;
        if (name.size() == 68 && name.compare(0, 4, "tmp-") == 0 && opaque_name(name.substr(4))) {
            fs::remove_all(entry.path());
            continue;
        }
        if (!opaque_name(name) || !entry.is_directory())
            continue;
        uint64_t size = 0;
        size_t files = 0;
        for (const auto& file : fs::directory_iterator(entry.path())) {
            if (++files > max_chunks + 1 || fs::is_symlink(file.symlink_status()) ||
                !file.is_regular_file())
                throw std::runtime_error("snapshot: invalid store entry");
            size += file.file_size();
            if (size > snapshot_limit + (1ull << 20))
                throw std::runtime_error("snapshot: oversized entry");
        }
        total += size;
        entries.push_back({entry.path(), entry.last_write_time(), size});
    }
    std::sort(entries.begin(), entries.end(),
              [](const Entry& a, const Entry& b) { return a.time < b.time; });
    size_t count = entries.size();
    for (const auto& entry : entries) {
        if (total + requested <= store_limit && count < retained_snapshots)
            break;
        if (entry.path == destination)
            continue;
        fs::remove_all(entry.path);
        total -= entry.bytes;
        --count;
    }
    if (total + requested > store_limit || count >= retained_snapshots)
        throw std::runtime_error("snapshot: quota exhausted");
}
} // namespace rkva_snapshot

bool RemoteAttnEngine::disk_snapshot(uint32_t id, const std::string& local_folder,
                                     const rkva_snapshot_req& request, bool restore,
                                     rkva_snapshot_ack* ack, std::string* error) {
    namespace snap = rkva_snapshot;
    Session* s = find_session(id);
    // The native codec stores the revision 1/2 128-row tail ring. Revision 3
    // (256-row ring + per-layer prefix coverage) has no disk codec yet: refuse
    // save and restore before any mutation instead of reusing the old layout.
    if (s && s->range_configured && s->range_storage == 3 &&
        rkva_kvarn_range::serial_prefix(s->range_descriptor))
        return ::fail(error, "snapshot: native descriptor revision 3 has no disk codec");
    if (!ready_ || !s || !s->valid || !s->range_configured || local_folder.empty() || !ack ||
        !request.live_rows || request.live_rows > s->capacity || request.revision != 1 ||
        request.flags || request.reserved || s->range_storage > 3 ||
        std::all_of(std::begin(request.host_state_sha256), std::end(request.host_state_sha256),
                    [](uint8_t b) { return b == 0; }))
        return ::fail(error, "snapshot: invalid session/request");
    const uint32_t rows = request.live_rows;
    const uint32_t groups = s->range_storage == 3 ? rows / 128 : 0;
    snap::Header header{};
    header.request = request;
    header.geometry = geo_;
    header.origin = s->range_origin;
    header.capacity = s->capacity;
    header.storage = s->range_storage;
    if (s->range_storage == 3)
        header.descriptor = s->range_descriptor;
    std::vector<snap::Chunk> layout;
    auto add_span = [&](uint32_t layer, uint64_t offset, uint64_t bytes) {
        while (bytes) {
            const uint32_t size = uint32_t(std::min(bytes, snap::chunk_bytes));
            snap::Chunk c{};
            c.layer = layer;
            c.offset = offset;
            c.bytes = size;
            layout.push_back(c);
            header.payload_bytes += size;
            offset += size;
            bytes -= size;
        }
    };
    const uint64_t row_bytes =
        uint64_t(geo_.n_head_kv) * (s->range_storage == 1   ? (geo_.head_dim / 32) * 18
                                    : s->range_storage == 2 ? (geo_.head_dim / 32) * 34
                                                            : geo_.head_dim * 2);
    for (uint32_t layer = 0; layer < s->layer_kv.size(); ++layer) {
        if (!restore && (s->range_counts[layer] != rows ||
                         (s->range_storage == 3 &&
                          (!s->range_ready[layer] || s->range_record_groups[layer] != groups))))
            return ::fail(error, "snapshot: layers not at the same evaluated checkpoint");
        for (uint32_t kind = 0; kind < 2; ++kind) {
            const uint64_t base = kind * s->half_stride;
            if (s->range_storage == 3) {
                add_span(layer, base, uint64_t(groups) * geo_.n_head_kv * 2 * 8960);
                add_span(layer, base + s->records_bytes, s->stage_bytes);
                add_span(layer, base + s->records_bytes + s->stage_bytes,
                         uint64_t(std::min(rows, s->precision_tail_tokens)) * row_bytes);
            } else
                add_span(layer, base, uint64_t(rows) * row_bytes);
        }
    }
    if (header.payload_bytes > snap::snapshot_limit || layout.empty() ||
        layout.size() > snap::max_chunks)
        return ::fail(error, "snapshot: payload exceeds bounded store");
    header.chunks = uint32_t(layout.size());
    const auto root = snap::fs::u8path(local_folder) / "rkva-snapshots-v1";
    const auto key = snap::hex(request.host_state_sha256);
    const auto destination = root / key;
    const auto temporary = root / ("tmp-" + key);
    bool mutated = false;
    try {
        if (snap::fs::is_symlink(snap::fs::symlink_status(root)))
            throw std::runtime_error("snapshot: invalid root");
        if (restore) {
            const auto stored = snap::read_manifest(destination, header);
            // Validate every extent and every checksum BEFORE touching live GPU
            // state. Recheck each chunk on the transfer pass to reject TOCTOU.
            std::vector<uint8_t> buffer(static_cast<size_t>(snap::chunk_bytes));
            for (size_t i = 0; i < stored.size(); ++i) {
                if (stored[i].layer != layout[i].layer || stored[i].offset != layout[i].offset ||
                    stored[i].bytes != layout[i].bytes)
                    throw std::runtime_error("snapshot: invalid chunk layout");
                const auto file = snap::chunk_path(destination, i);
                snap::check_regular(file, stored[i].bytes);
                std::ifstream input(file, std::ios::binary);
                snap::read_exact(input, buffer.data(), stored[i].bytes);
                if (snap::digest(buffer.data(), stored[i].bytes) != stored[i].sha)
                    throw std::runtime_error("snapshot: KV checksum mismatch");
            }
            Buffer& upload = snapshot_upload_;
            if (!upload.resource &&
                !create_buffer(snap::chunk_bytes, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_FLAG_NONE,
                               D3D12_RESOURCE_STATE_GENERIC_READ, &upload, error))
                return false;
            mutated = true;
            s->valid = false;
            for (size_t i = 0; i < stored.size(); ++i) {
                std::ifstream input(snap::chunk_path(destination, i), std::ios::binary);
                snap::read_exact(input, buffer.data(), stored[i].bytes);
                if (snap::digest(buffer.data(), stored[i].bytes) != stored[i].sha)
                    throw std::runtime_error("snapshot: file changed during restore");
                void* mapped = nullptr;
                HRESULT hr = upload.resource->Map(0, nullptr, &mapped);
                if (FAILED(hr))
                    return fail(error, "snapshot: map upload", hr);
                std::memcpy(mapped, buffer.data(), stored[i].bytes);
                upload.resource->Unmap(0, nullptr);
                if (!begin(error))
                    return false;
                auto& target = s->layer_kv[stored[i].layer];
                transition(target, D3D12_RESOURCE_STATE_COPY_DEST);
                cmd_->CopyBufferRegion(target.resource.Get(), stored[i].offset,
                                       upload.resource.Get(), 0, stored[i].bytes);
                transition(target, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
                if (!submit(error))
                    return false;
            }
            // One publication point for ALL layers. No stale future positions.
            std::fill(s->range_counts.begin(), s->range_counts.end(), rows);
            std::fill(s->range_record_groups.begin(), s->range_record_groups.end(), groups);
            std::fill(s->range_ready.begin(), s->range_ready.end(), s->range_storage == 3);
            s->high_water = int32_t(s->range_origin + rows - 1);
            s->valid = true;
        } else {
            snap::fs::create_directories(root);
            // Immutable content key. A published snapshot is never overwritten
            // or deleted in order to replace it; publication is one directory rename.
            if (snap::fs::exists(destination)) {
                const auto existing = snap::read_manifest(destination, header);
                for (size_t i = 0; i < layout.size(); ++i)
                    if (existing[i].layer != layout[i].layer ||
                        existing[i].offset != layout[i].offset ||
                        existing[i].bytes != layout[i].bytes)
                        throw std::runtime_error("snapshot: existing layout mismatch");
            } else {
                snap::make_room(root, destination, header.payload_bytes + (1ull << 20));
                snap::fs::create_directory(temporary);
                Buffer& readback = snapshot_readback_;
                if (!readback.resource &&
                    !create_buffer(snap::chunk_bytes, D3D12_HEAP_TYPE_READBACK,
                                   D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST,
                                   &readback, error)) {
                    snap::fs::remove_all(temporary);
                    return false;
                }
                for (size_t i = 0; i < layout.size(); ++i) {
                    if (!begin(error)) {
                        snap::fs::remove_all(temporary);
                        return false;
                    }
                    auto& source = s->layer_kv[layout[i].layer];
                    const auto previous = source.state;
                    transition(source, D3D12_RESOURCE_STATE_COPY_SOURCE);
                    cmd_->CopyBufferRegion(readback.resource.Get(), 0, source.resource.Get(),
                                           layout[i].offset, layout[i].bytes);
                    transition(source, previous);
                    if (!submit(error)) {
                        s->valid = false;
                        snap::fs::remove_all(temporary);
                        return false;
                    }
                    void* mapped = nullptr;
                    D3D12_RANGE range{0, layout[i].bytes};
                    HRESULT hr = readback.resource->Map(0, &range, &mapped);
                    if (FAILED(hr)) {
                        snap::fs::remove_all(temporary);
                        return fail(error, "snapshot: map readback", hr);
                    }
                    layout[i].sha = snap::digest(mapped, layout[i].bytes);
                    try {
                        snap::write_exact(snap::chunk_path(temporary, i), mapped, layout[i].bytes);
                    } catch (...) {
                        D3D12_RANGE empty{0, 0};
                        readback.resource->Unmap(0, &empty);
                        throw;
                    }
                    D3D12_RANGE empty{0, 0};
                    readback.resource->Unmap(0, &empty);
                }
                std::vector<uint8_t> manifest(sizeof(header) + layout.size() * sizeof(snap::Chunk));
                std::memcpy(manifest.data(), &header, sizeof(header));
                std::memcpy(manifest.data() + sizeof(header), layout.data(),
                            layout.size() * sizeof(snap::Chunk));
                const auto checksum = snap::digest(manifest.data(), manifest.size());
                manifest.insert(manifest.end(), checksum.begin(), checksum.end());
                snap::write_exact(temporary / "manifest.bin", manifest.data(), manifest.size());
                snap::fs::rename(temporary, destination);
            }
        }
        std::memcpy(ack->host_state_sha256, request.host_state_sha256, 32);
        ack->live_rows = rows;
        ack->n_layers = geo_.n_layers;
        ack->disk_bytes = header.payload_bytes;
        return true;
    } catch (const std::exception& exception) {
        if (mutated)
            s->valid = false;
        if (!restore) {
            std::error_code ignored;
            snap::fs::remove_all(temporary, ignored);
        }
        if (error)
            *error = exception.what();
        return false;
    }
}
