<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- External sources use %(RelativeDir), including ..\. Tag the project
       prefix so walking out of Release cannot alias the iteration objects. -->
  <PropertyGroup Condition="'$(XllamaIteration)' != 'true'">
    <IntDir>$(ProjectDir)$(MSBuildProjectName)-final\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XllamaIteration)' == 'true'">
    <IntDir>$(ProjectDir)$(MSBuildProjectName)\$(Platform)\$(Configuration)-iteration\</IntDir>
    <OutDir>$(ProjectDir)$(Platform)\$(Configuration)-iteration\</OutDir>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(XllamaIteration)' == 'true'">
    <ClCompile><WholeProgramOptimization>false</WholeProgramOptimization></ClCompile>
    <Link><LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration></Link>
  </ItemDefinitionGroup>
</Project>
