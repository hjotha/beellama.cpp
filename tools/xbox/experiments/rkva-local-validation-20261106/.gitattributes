* text eol=lf
# Unified patches intentionally contain space-prefixed empty context lines.
*.patch -whitespace
# Preserve exact archived fixture bytes (and source hashes), including EOF blanks.
**/*.hlsl whitespace=blank-at-eol,space-before-tab,-blank-at-eof
**/*.hlsli whitespace=blank-at-eol,space-before-tab,-blank-at-eof
mq2/fixtures/*.inc whitespace=blank-at-eol,space-before-tab,-blank-at-eof
qrot/source-main/*.h whitespace=blank-at-eol,space-before-tab,-blank-at-eof
